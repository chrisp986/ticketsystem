          "value": "\"tickets\".\"status\" <> 'resolved' OR \"tickets\".\"resolved_at\" IS NOT NULL"
        },
        "tickets_resolved_at_only_when_resolved_or_closed": {
          "name": "tickets_resolved_at_only_when_resolved_or_closed",
          "value": "\"tickets\".\"status\" IN ('resolved', 'closed') OR \"tickets\".\"resolved_at\" IS NULL"
        },
        "tickets_reopen_count_not_negative": {
          "name": "tickets_reopen_count_not_negative",
          "value": "\"tickets\".\"reopen_count\" >= 0"
        },
        "tickets_resolved_at_has_first_resolved_at": {
          "name": "tickets_resolved_at_has_first_resolved_at",
          "value": "\"tickets\".\"resolved_at\" IS NULL OR \"tickets\".\"first_resolved_at\" IS NOT NULL"
        },
        "tickets_resolution_only_when_resolved_or_closed": {
          "name": "tickets_resolution_only_when_resolved_or_closed",
          "value": "\"tickets\".\"status\" IN ('resolved', 'closed') OR (\"tickets\".\"resolution\" IS NULL AND \"tickets\".\"resolution_summary\" IS NULL)"
        },
        "tickets_resolved_has_resolution_and_summary": {
          "name": "tickets_resolved_has_resolution_and_summary",
          "value": "\"tickets\".\"status\" <> 'resolved' OR (\"tickets\".\"resolution\" IS NOT NULL AND \"tickets\".\"resolution\" IN ('solved', 'workaround') AND \"tickets\".\"resolution_summary\" IS NOT NULL AND btrim(\"tickets\".\"resolution_summary\") <> '')"
        },
        "tickets_closed_has_resolution": {
          "name": "tickets_closed_has_resolution",
          "value": "\"tickets\".\"status\" <> 'closed' OR \"tickets\".\"resolution\" IS NOT NULL"
        },
        "tickets_closed_unresolved_not_solved": {
          "name": "tickets_closed_unresolved_not_solved",
          "value": "\"tickets\".\"status\" <> 'closed' OR \"tickets\".\"resolved_at\" IS NOT NULL OR \"tickets\".\"resolution\" NOT IN ('solved', 'workaround')"
        },
        "tickets_open_has_next_step_due": {
          "name": "tickets_open_has_next_step_due",
          "value": "\"tickets\".\"status\" = 'closed' OR \"tickets\".\"next_step_due\" IS NOT NULL"
        },
        "tickets_attention_fields_together": {
          "name": "tickets_attention_fields_together",
          "value": "(\"tickets\".\"attention_since\" IS NULL) = (\"tickets\".\"attention_reason\" IS NULL)"
        },
        "tickets_attention_only_when_open": {
          "name": "tickets_attention_only_when_open",
          "value": "\"tickets\".\"status\" <> 'closed' OR \"tickets\".\"attention_since\" IS NULL"
        },
        "tickets_next_step_owner_only_when_open": {
          "name": "tickets_next_step_owner_only_when_open",
          "value": "\"tickets\".\"status\" <> 'closed' OR \"tickets\".\"next_step_owner_id\" IS NULL"
        },
        "tickets_created_by_valid": {
          "name": "tickets_created_by_valid",
          "value": "(\"tickets\".\"created_by_type\" = 'user' AND \"tickets\".\"created_by_id\" IS NOT NULL AND \"tickets\".\"created_by_name\" IS NULL) OR (\"tickets\".\"created_by_type\" <> 'user' AND \"tickets\".\"created_by_id\" IS NULL AND \"tickets\".\"created_by_name\" IS NOT NULL AND btrim(\"tickets\".\"created_by_name\") <> '' AND \"tickets\".\"created_by_name\" = lower(\"tickets\".\"created_by_name\") AND char_length(\"tickets\".\"created_by_name\") <= 100)"
        }
